{% extends '@ui/Base/View/base.html.twig' %}

{% block title %}Produkty{% endblock %}

{% block body %}

    <div class="page-header">
        <h1 class="page-header__title">Produkty</h1>

        <a href="{{ path('shop_products_create') }}" class="button">
            + Dodaj produkt
        </a>
    </div>

    <table class="table">
        <thead>
        <tr>
            <th>Nazwa</th>
            <th>Cena</th>
            <th>Stan</th>
            <th>Aktywny</th>
            <th>Kategoria</th>
            <th></th>
        </tr>
        </thead>

        <tbody>
        {% for product in products %}
            <tr>
                <td>{{ product.name }}</td>

                <td>
                    {{ product.price.amount|money_amount }}
                    {{ product.price.currency|money_currency }}
                </td>

                <td>{{ product.stock }}</td>

                <td>
                    {{ product.isActive ? 'Tak' : 'Nie' }}
                </td>

                <td>
                    {{ product.category.name }}
                </td>

                <td class="table__actions">
                    <a href="{{ path('shop_products_edit', { id: product.id }) }}" class="button">
                        Edytuj
                    </a>

                    <form
                        method="post"
                        action="{{ path('shop_products_delete', { id: product.id }) }}"
                        style="display:inline"
                            onsubmit="return confirm('Usunąć produkt {{ product.name }}?');"
                    >
                        <input
                            type="hidden"
                            name="_token"
                            value="{{ csrf_token('delete_product_' ~ product.id) }}"
                        >

                        <button
                            type="submit"
                            class="button button--danger"
                        >
                            Usuń
                        </button>
                    </form>

                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6">Brak produktów.</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

{% endblock %}
