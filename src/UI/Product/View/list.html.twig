{% extends '@ui/Base/View/base.html.twig' %}

{% block title %}Products{% endblock %}

{% block body %}

    <div class="page-header">
        <h1 class="page-header__title">Products</h1>

        <a href="{{ path('shop_products_create') }}" class="button">
            + Add product
        </a>
    </div>

    <table class="table">
        <thead>
        <tr>
            <th>Name</th>
            <th>Price</th>
            <th>Stock</th>
            <th>Active</th>
            <th></th>
        </tr>
        </thead>

        <tbody>
        {% for product in products %}
            <tr>
                <td>{{ product.name }}</td>

                <td>
                    {{ product.price.amount }}
                    {{ product.price.currency }}
                </td>

                <td>{{ product.stock }}</td>

                <td>
                    {{ product.isActive ? 'Yes' : 'No' }}
                </td>

                <td>
                    <a href="{{ path('shop_products_edit', { id: product.id }) }}">
                        Edit
                    </a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5">No products found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

{% endblock %}
