<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8">
    {% block stylesheets %}
        {{ encore_entry_link_tags('app') }}
    {% endblock %}

    {% block javascripts %}
        {{ encore_entry_script_tags('app') }}
    {% endblock %}
    <title>{% block title %}Marcel Sklep{% endblock %}</title>
</head>
<body>
    <div class="page">
        {% include '@ui/Base/View/header.html.twig' %}
        <main class="main">
            <div class="layout-container">
                {% for message in app.flashes('success') %}
                    <div class="flash flash--success">{{ message }}</div>
                {% endfor %}
                {% for message in app.flashes('error') %}
                    <div class="flash flash--error">{{ message }}</div>
                {% endfor %}
                {% block body %}{% endblock %}
            </div>
        </main>
    </div>
</body>
</html>
