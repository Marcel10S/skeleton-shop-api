<header class="header">
    {% set currentRoute = app.request.attributes.get('_route') %}
    <div class="header__container">

        <div class="header__left">
            <div class="header__logo">
                <span class="header__logo--icon">🌀</span>
                <span class="header__logo--text">Marcel Sklep</span>
            </div>
        </div>

        <nav class="header__nav">
            <a href="{{ path('shop_start') }}" class="header__link{{ currentRoute == 'shop_start' ? ' header__link--active' }}" {% if currentRoute == 'shop_start' %}aria-current="page"{% endif %}>
                Strona główna
            </a>
            <a href="{{ path('shop_products_list') }}" class="header__link{{ currentRoute starts with 'shop_products_' ? ' header__link--active' }}" {% if currentRoute starts with 'shop_products_' %}aria-current="page"{% endif %}>
                Produkty
            </a>
            <a href="{{ path('shop_categories_list') }}" class="header__link{{ currentRoute starts with 'shop_categories_' ? ' header__link--active' }}" {% if currentRoute starts with 'shop_categories_' %}aria-current="page"{% endif %}>
                Kategorie
            </a>
            <a href="{{ path('shop_orders_list') }}" class="header__link{{ currentRoute starts with 'shop_orders_' ? ' header__link--active' }}" {% if currentRoute starts with 'shop_orders_' %}aria-current="page"{% endif %}>
                Zamówienia
            </a>
            <a href="{{ path('shop_currencies_list') }}" class="header__link{{ currentRoute starts with 'shop_currencies_' ? ' header__link--active' }}" {% if currentRoute starts with 'shop_currencies_' %}aria-current="page"{% endif %}>
                Waluty
            </a>
            <a href="{{ path('shop_payment_methods_list') }}" class="header__link{{ currentRoute starts with 'shop_payment_methods_' ? ' header__link--active' }}" {% if currentRoute starts with 'shop_payment_methods_' %}aria-current="page"{% endif %}>
                Płatności
            </a>
            <a href="{{ path('shop_delivery_methods_list') }}" class="header__link{{ currentRoute starts with 'shop_delivery_methods_' ? ' header__link--active' }}" {% if currentRoute starts with 'shop_delivery_methods_' %}aria-current="page"{% endif %}>
                Dostawy
            </a>
            <a href="{{ path('shop_carts_active_list') }}" class="header__link{{ currentRoute starts with 'shop_carts_' ? ' header__link--active' }}" {% if currentRoute starts with 'shop_carts_' %}aria-current="page"{% endif %}>
                Aktywne koszyki
            </a>
        </nav>

    </div>
</header>
