{% extends '@ui/Base/View/base.html.twig' %}

{% block title %}New order{% endblock %}

{% block body %}
    <div class="form-page">
        <div class="page-header">
            <h1 class="page-header__title">New order</h1>
        </div>

        {{ form_start(form, { attr: { class: 'form order-form', 'data-order-form': true } }) }}

        <div
            class="order-form__items"
            data-order-items
            data-prototype="{{ include('@ui/Order/View/_item.html.twig', { item: form.items.vars.prototype })|e('html_attr') }}"
            data-index="{{ form.items|length }}"
        >
            {% for item in form.items %}
                {% include '@ui/Order/View/_item.html.twig' with { item: item } %}
            {% endfor %}
        </div>

        {{ form_errors(form.items) }}

        <button type="button" class="button button--secondary" data-order-item-add>Add product</button>

        <div class="form__actions">
            <button class="button" type="submit">Create order</button>
            <a href="{{ path('shop_orders_list') }}" class="button button--secondary">Cancel</a>
        </div>

        {{ form_end(form) }}
    </div>
{% endblock %}
