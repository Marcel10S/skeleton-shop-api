{% extends '@ui/Base/View/base.html.twig' %}

{% block title %}Zamówienia{% endblock %}

{% block body %}
    <div class="page-header">
        <h1 class="page-header__title">Zamówienia</h1>
        <a href="{{ path('shop_orders_create') }}" class="button">+ Dodaj zamówienie</a>
    </div>

    <table class="table">
        <thead>
            <tr>
                <th>Utworzono</th>
                <th>Produkty</th>
                <th>Dostawa</th>
                <th>Płatność</th>
                <th>Suma</th>
            </tr>
        </thead>
        <tbody>
            {% for order in orders %}
                <tr>
                    <td>{{ order.createdAt|date('Y-m-d H:i') }}</td>
                    <td>
                        {% for item in order.items %}
                            <div>{{ item.productName }} × {{ item.quantity }}</div>
                        {% endfor %}
                    </td>
                    <td>
                        {% if order.delivery %}
                            <strong>{{ order.delivery.courier|upper }}</strong><br>
                            {{ order.delivery.recipientName }}<br>
                            {{ order.delivery.addressLine }}<br>
                            {{ order.delivery.postalCode }} {{ order.delivery.city }}
                        {% else %}
                            —
                        {% endif %}
                    </td>
                    <td>
                        {{ order.paymentMethod.name }}<br>
                        <strong>{{ order.paymentStatus == 'paid' ? 'Opłacone' : 'Oczekuje na płatność' }}</strong>
                    </td>
                    <td>
                        {% for currency, amount in order.totalsByCurrency %}
                            <div>{{ amount|money_amount }} {{ currency|money_currency }}</div>
                        {% endfor %}
                        <strong>
                            Łącznie w walucie domyślnej:
                            {{ order.totalInDefaultCurrency|money_amount }}
                            {{ defaultCurrency.code|money_currency }}
                        </strong>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="5">Brak zamówień.</td></tr>
            {% endfor %}
        </tbody>
    </table>
{% endblock %}
