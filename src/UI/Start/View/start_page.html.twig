{% extends '@ui/Base/View/base.html.twig' %}

{% block title %}Panel zarządzania{% endblock %}

{% block body %}
    <section class="manager-home">
        <p class="manager-home__eyebrow">Panel zarządzania</p>
        <h1 class="manager-home__title">Zarządzaj swoim sklepem internetowym</h1>
        <p class="manager-home__intro">
            W tym miejscu możesz prowadzić katalog produktów, organizować kategorie
            zarządzać koszykami oraz tworzyć i przeglądać zamówienia.
        </p>

        <div class="manager-home__actions">
            <a href="{{ path('shop_products_list') }}" class="button">Przejdź do produktów</a>
            <a href="{{ path('shop_orders_list') }}" class="button button--secondary">Zobacz zamówienia</a>
            <a href="{{ path('shop_carts_active_list') }}" class="button button--secondary">Aktywne koszyki</a>
        </div>

        <div class="manager-home__features">
            <article class="manager-home__feature">
                <h2>Produkty</h2>
                <p>Dodawaj, edytuj i kontroluj dostępność produktów w ofercie.</p>
            </article>
            <article class="manager-home__feature">
                <h2>Kategorie</h2>
                <p>Porządkuj produkty w przejrzystej, wielopoziomowej strukturze.</p>
            </article>
            <article class="manager-home__feature">
                <h2>Zamówienia</h2>
                <p>Twórz zamówienia z wielu produktów i sprawdzaj sumy według walut.</p>
            </article>
            <article class="manager-home__feature">
                <h2>Koszyki i dostawy</h2>
                <p>Śledź aktywne koszyki oraz dostępne metody płatności i formy dostawy.</p>
            </article>
        </div>
    </section>
{% endblock %}
