<tr
    data-category-row
    data-category-id="{{ node.category.id }}"
    {% if parentId is defined %}data-parent-id="{{ parentId }}"{% endif %}
>
    <td class="category-tree__name" style="--category-depth: {{ node.depth }}">

        {% if node.children|length %}
            <button
                class="category-tree__toggle"
                type="button"
                data-category-toggle="{{ node.category.id }}"
                aria-expanded="true"
                aria-label="Zwiń kategorię"
            ></button>
        {% else %}
            <span class="category-tree__spacer" aria-hidden="true"></span>
        {% endif %}

        <span class="category-tree__category-name">{{ node.category.name }}</span>

    </td>

    <td>
        {{ node.category.products|length }}
    </td>

    <td>

        <a class="category-tree__edit-link" href="{{ path('shop_categories_edit', {id: node.category.id}) }}">
            Edytuj
        </a>

    </td>

</tr>

{% for child in node.children %}

    {% include '@ui/Category/View/category_tree_node.html.twig'
        with { node: child, parentId: node.category.id } %}

{% endfor %}
