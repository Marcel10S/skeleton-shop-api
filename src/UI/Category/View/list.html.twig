{% extends '@ui/Base/View/base.html.twig' %}

{% block title %}Kategorie{% endblock %}

{% block body %}

    <div class="page-header">
        <h1 class="page-header__title">Kategorie</h1>

        <a href="{{ path('shop_categories_create') }}" class="button">
            + Dodaj kategorię
        </a>
    </div>

    <table class="table category-tree" data-category-tree>
        <thead>
            <tr>
                <th>Nazwa</th>
                <th>Produkty</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            {% for node in tree %}
                {% include '@ui/Category/View/category_tree_node.html.twig'
                    with { node: node } %}
            {% endfor %}
        </tbody>
    </table>

{% endblock %}
